# ---- Alpaca Paper Trading credentials (server-side only, NEVER exposed to the browser) ----
# Get free paper trading keys at https://app.alpaca.markets (Paper Trading section)
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret_key

# Paper trading ONLY. Never set this to https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: override data API base (defaults to https://data.alpaca.markets)
# ALPACA_DATA_URL=https://data.alpaca.markets

# ---- Demo mode ----
# Set ALPACA_MOCK=true to run the full agent pipeline against clearly-labeled
# simulated data (no Alpaca keys needed). Leave unset/empty for real paper trading.
ALPACA_MOCK=

# ---- Agent tuning (optional, sane defaults in code) ----
# AGENT_MIN_SCORE=75
# AGENT_MAX_RISK_PCT=1.0
# AGENT_PROFIT_PCT=0.25        # auto-exit when spread gains 25% of debit
# AGENT_MAX_LOSS_PCT=0.20     # auto-exit when spread loses 20% of debit
# AGENT_TIME_EXIT_DTE=7       # auto-exit when 7 or fewer days to expiry
